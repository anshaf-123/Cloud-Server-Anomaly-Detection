# Database Settings (XAMPP / WAMP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_monitoring
DB_USER=root
DB_PASSWORD=

# Server Simulator Configuration
SIM_NUM_SERVERS=3
SIM_INTERVAL_SECONDS=5
SIM_ANOMALY_RATE=0.05

# Anomaly Detection Settings
ENSEMBLE_THRESHOLD=0.5
WEIGHT_IFOREST=0.25
WEIGHT_LOF=0.20
WEIGHT_DBSCAN=0.15
WEIGHT_PYTHON_STAT=0.20
WEIGHT_R_STAT=0.20

# System Paths (for automatic website deployment)
XAMPP_HTDOCS_PATH=C:/xampp/htdocs
